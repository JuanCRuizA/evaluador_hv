OPENROUTER_API_KEY=
# Modelo elegido por barato (~0,075 / 0,20 USD por millón de tokens de entrada / salida), sin
# razonamiento (rápido y sin gasto oculto), con soporte de herramientas y salida estructurada
# según el catálogo de OpenRouter el 2026-10-24. Alternativa: deepseek/deepseek-v4-flash-0731.
# Evite las variantes ":free" (pueden guardar los prompts) y ":batch". Revise en openrouter.ai la
# política de datos de la cuenta (desactive el uso de prompts para entrenamiento): se envían
# textos de hojas de vida.
OPENROUTER_MODEL=mistralai/mistral-small-3.2-24b-instruct
# Opcional: endpoint compatible con OpenAI (por defecto el de abajo; permite cambiar de proveedor)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Opcional: esfuerzo de razonamiento (low, medium, high; según el modelo). Si se define y la API
# lo rechaza, se reintenta una vez sin él. Sin definir = se omite.
# OPENROUTER_REASONING_EFFORT=low
# Opcional: tope de tokens de salida por petición (entero positivo; por defecto 4000). Protege el
# crédito. Si la API lo rechaza, se reintenta una vez sin él.
# OPENROUTER_MAX_TOKENS=4000
MAX_TURNOS_AGENTE=12
# Tiempo máximo total (segundos) de una evaluación con IA, reintento incluido.
# Debe ser menor que 240 (el reclamo caduca a los 300 s y Vercel corta a los 300 s)
TIMEOUT_AGENTE_S=150
SECRET_KEY=
APP_PASSWORD=
# Solo para demostraciones (p. ej. Vercel sin base de datos): descomente y deje DATABASE_URL sin definir.
# Usa SQLite en memoria. Límites: los datos son efímeros (se pierden al reiniciar), cada instancia
# tiene su propia memoria y dos peticiones pueden caer en instancias distintas. No para uso real.
# BD_EN_MEMORIA=1
